menu "Ground video recovery"

config VSTREAMER_RS_PIE
    bool "Use ESP32-P4 PIE SIMD for Reed-Solomon recovery"
    depends on SOC_CPU_HAS_PIE
    default y
    help
        Compile the pinned vstreamer PIE GF matrix kernel for missing-data
        reconstruction. Startup compares it with the scalar reference using
        unaligned inputs and odd lengths; mismatches disable PIE at runtime.

config VSTREAMER_RX_PSRAM
    bool "Allocate FEC padding and recovered rows in PSRAM"
    depends on SPIRAM
    default y

endmenu
