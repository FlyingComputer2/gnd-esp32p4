CONFIG_IDF_TARGET="esp32p4"
# The Guition JC-ESP32P4-M3 carries a rev v1.3 P4. IDF 5.5 builds for >= 3.1 by
# default, and such an image dies in the bootloader with "Illegal instruction".
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_FREERTOS_HZ=1000
# Console on UART0 (GPIO37/38), the board's CH340C USB-C port.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_NETIF_LOOPBACK=y
CONFIG_LWIP_LOOPBACK_MAX_PBUFS=16
CONFIG_TINYUSB_VENDOR_COUNT=1
CONFIG_TINYUSB_VENDOR_RX_BUFSIZE=8192
CONFIG_TINYUSB_VENDOR_TX_BUFSIZE=4096
CONFIG_TINYUSB_VENDOR_EPSIZE=512

# Two app slots for POST /update/p4; a new image stays pending until the
# network reaches it (first UDP or HTTP request), else the next reset boots the
# previous one.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384

# One full Ethernet frame per descriptor; room for recovered RTP bursts.
CONFIG_ETH_DMA_BUFFER_SIZE=1600
CONFIG_ETH_DMA_TX_BUFFER_NUM=24
CONFIG_ETH_DMA_RX_BUFFER_NUM=16

CONFIG_FREERTOS_USE_TRACE_FACILITY=y

CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

# Ground compiles vstreamer directly; expose its PIE recovery option locally.
CONFIG_VSTREAMER_RS_PIE=y
CONFIG_GROUND_VIDEO_PSRAM_PACKETS=y
CONFIG_VSTREAMER_RX_PSRAM=y
