# Waveshare ESP32-P4-WIFI6-DEV-KIT (P4 rev v3.x), on top of sdkconfig.defaults:
#   idf.py -B build-waveshare -D SDKCONFIG=build-waveshare/sdkconfig \
#     -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.waveshare" build
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_C6_BRIDGE_BOARD_WAVESHARE=y
