menu "C6 UART bridge"

choice C6_BRIDGE_BOARD
    prompt "Board"
    default C6_BRIDGE_BOARD_GUITION
    help
        Both boards wire the C6's UART0 to P4 GPIO32/33, TX and RX swapped
        between them, and its CHIP_PU to GPIO54. They also differ in the
        C6 GPIO9 (boot strap) pin.

config C6_BRIDGE_BOARD_GUITION
    bool "Guition JC-ESP32P4-M3-DEV (boot strap GPIO45, LDO_VO4)"

config C6_BRIDGE_BOARD_WAVESHARE
    bool "Waveshare ESP32-P4-WIFI6-DEV-KIT (boot strap GPIO22)"

endchoice

endmenu
