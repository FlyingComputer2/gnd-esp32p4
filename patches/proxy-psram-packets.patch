diff --git a/components/winject_proxy/dplane_queue.cpp b/components/winject_proxy/dplane_queue.cpp
index 83bf89b..3e07661 100644
--- a/components/winject_proxy/dplane_queue.cpp
+++ b/components/winject_proxy/dplane_queue.cpp
@@ -1,4 +1,8 @@
 #include "dplane_queue.h"
+#include "sdkconfig.h"
+#ifdef CONFIG_GROUND_VIDEO_PSRAM_PACKETS
+#include "esp_heap_caps.h"
+#endif
 
 #include <memory>
 #include <mutex>
@@ -99,7 +103,18 @@ bool dplane_queue_push(const uint8_t *data, size_t len)
     if (!forward || !cv) {
         return false;
     }
+    #ifdef CONFIG_GROUND_VIDEO_PSRAM_PACKETS
+    // This is the existing DMA/borrowed-input ownership copy, placed where
+    // long-lived queue/FEC/output references cannot consume driver RAM.
+    auto *bytes = static_cast<std::byte*>(heap_caps_malloc(len, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (!bytes) return true; // The input frame was dropped, same accounting as eviction.
+    auto packet = bfc::shared_sized_buffer::adopt(bytes, len, len,
+        [](std::byte *p) { heap_caps_free(p); });
+    std::memcpy(packet.data(), data, len);
+    const size_t before = forward->push(std::move(packet));
+#else
     const size_t before = forward->push(bfc::shared_sized_buffer::copy_from(data, len));
+#endif
     const size_t capacity = forward->capacity();
     cv->wake_up();
     return capacity != 0 && before >= capacity;
